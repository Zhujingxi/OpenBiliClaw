{
  "name": "openbiliclaw-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/api-client",
    "packages/presentation",
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{ts,vue,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,css,html}\"",
    "lint": "eslint --max-warnings 0 --ext .ts,.vue packages apps && python3 ../scripts/check_frontend_sources.py",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "generate:api": "python ../scripts/generate_api_client.py"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.3",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "jiti": "2.6.1",
    "jsdom": "27.3.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.1.8"
  }
}
