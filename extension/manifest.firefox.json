{
  "manifest_version": 3,
  "name": "OpenBiliClaw",
  "description": "跨平台内容发现 AI Agent — 画像、推荐、反馈与聊天",
  "browser_specific_settings": {
    "gecko": {
      "id": "openbiliclaw-firefox@whiteguo233.github.io",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/index.html"
  },
  "sidebar_action": {
    "default_title": "OpenBiliClaw",
    "default_panel": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup/index.html"
  }
}
