{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.201",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "cookies",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/index.html"
  },
  "side_panel": {
    "default_path": "popup/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
